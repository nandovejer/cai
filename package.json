{
  "name": "@cai-ds/monorepo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "predev": "node scripts/check-dist.js",
    "dev": "vite",
    "build": "pnpm tokens:build && pnpm core:build && pnpm platform:build",
    "pages:build": "pnpm build && vite build --mode pages",
    "core:build": "node scripts/build-core.js",
    "platform:build": "node scripts/build-platform.js",
    "placeholders:build": "node scripts/build-placeholders.js",
    "lint:css": "stylelint \"packages/**/*.css\" \"apps/**/*.css\"",
    "lint:js": "eslint \"packages/**/*.js\" \"apps/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"*.config.js\"",
    "tokens:build": "node scripts/build-tokens.js",
    "test:unit": "vitest run",
    "test:ui": "playwright test",
    "test:ui:install": "playwright install chromium",
    "check:pack": "node scripts/check-pack.js",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "check:size": "node scripts/check-size.js",
    "check:strings": "node scripts/check-strings.js",
    "check:exceptions": "node scripts/check-exceptions.js",
    "check:contrast": "node scripts/check-contrast.js",
    "check:generated": "node scripts/check-generated.js",
    "media:build": "node scripts/build-demo-media.js"
  },
  "//": "cai-exception: EX-004 — pnpm.auditConfig.ignoreGhsas lists dev-only advisories with no patched version; see EXCEPTIONS.md",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "source-map-js": ">=1.2.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm",
        "GHSA-hp3w-g68c-fv3c"
      ]
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^2.27.0",
    "@playwright/test": "^1.40.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "rollup": "^4.60.3",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
