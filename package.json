{
  "name": "@cai-ds/monorepo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "predev": "node scripts/check-dist.js",
    "dev": "vite",
    "build": "pnpm tokens:build && pnpm core:build && pnpm platform:build",
    "pages:build": "pnpm build && vite build --mode pages",
    "core:build": "node scripts/build-core.js",
    "platform:build": "node scripts/build-platform.js",
    "lint:css": "stylelint \"packages/**/*.css\" \"!packages/**/dist/**\"",
    "lint:js": "eslint \"packages/**/*.js\" \"scripts/**/*.js\"",
    "tokens:build": "node scripts/build-tokens.js",
    "test:unit": "vitest run",
    "test:ui": "playwright test",
    "test:ui:install": "playwright install chromium",
    "check:pack": "node scripts/check-pack.js",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "check:size": "node scripts/check-size.js",
    "check:strings": "node scripts/check-strings.js"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^2.27.0",
    "@playwright/test": "^1.40.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "rollup": "^4.60.3",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
