{
  "name": "@cai-ds/monorepo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev":          "vite",
    "build":        "pnpm tokens:build && pnpm core:build && pnpm platform:build",
    "core:build":   "node scripts/build-core.js",
    "platform:build": "node scripts/build-platform.js",
    "lint:css":     "stylelint \"packages/**/*.css\"",
    "lint:js":      "eslint \"packages/**/*.js\" \"scripts/**/*.js\"",
    "tokens:build": "node scripts/build-tokens.js",
    "test:unit":    "vitest run",
    "test:ui":      "playwright test",
    "test:ui:install": "playwright install chromium"
  },
  "devDependencies": {
    "vite":                      "^5.0.0",
    "stylelint":                 "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "vitest":                    "^1.0.0",
    "@vitest/ui":                "^1.0.0",
    "@playwright/test":          "^1.40.0",
    "eslint":                    "^9.0.0",
    "@changesets/cli":           "^2.27.0"
  }
}
