{
  "name": "@cai-ds/core",
  "version": "2.0.0",
  "description": "CAI Design System — CSS components and vanilla JS behaviors",
  "license": "MIT",
  "type": "module",
  "main": "dist/cai.js",
  "exports": {
    ".": "./dist/cai.js",
    "./css": "./dist/cai.css",
    "./css/min": "./dist/cai.min.css",
    "./base.css": "./dist/base.css",
    "./components/*": "./dist/components/*",
    "./themes/*": "./dist/themes/*",
    "./theme": "./dist/theme.js",
    "./sidebar": "./dist/sidebar.js",
    "./clipboard": "./dist/clipboard.js",
    "./modal": "./dist/modal.js",
    "./highlight": "./dist/highlight.js",
    "./player": "./dist/player.js",
    "./tabs": "./dist/tabs.js",
    "./midi": "./dist/midi.js",
    "./utils": "./dist/utils.js",
    "./i18n": "./dist/i18n.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nandovejer/cai.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/nandovejer/cai#readme",
  "bugs": {
    "url": "https://github.com/nandovejer/cai/issues"
  },
  "keywords": [
    "design-system",
    "css",
    "components",
    "vanilla-js",
    "itcss",
    "accessibility",
    "a11y"
  ],
  "sideEffects": [
    "*.css",
    "./dist/cai.js",
    "./dist/cai.min.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@cai-ds/tokens": "^2.0.0"
  },
  "devDependencies": {
    "@cai-ds/tokens": "workspace:*"
  }
}
