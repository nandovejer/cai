{
  "name": "@luz-ds/core",
  "version": "0.0.0",
  "description": "LUZ Design System — CSS components and vanilla JS behaviors",
  "license": "MIT",
  "type": "module",
  "main": "dist/luz.js",
  "exports": {
    ".": "./dist/luz.js",
    "./css": "./dist/luz.css",
    "./css/min": "./dist/luz.min.css",
    "./base.css": "./dist/base.css",
    "./print.css": "./dist/print.css",
    "./classless.css": "./dist/classless.css",
    "./components/*": "./dist/components/*",
    "./themes/*": "./dist/themes/*",
    "./theme": "./dist/theme.js",
    "./sidebar": "./dist/sidebar.js",
    "./clipboard": "./dist/clipboard.js",
    "./modal": "./dist/modal.js",
    "./highlight": "./dist/highlight.js",
    "./player": "./dist/player.js",
    "./tabs": "./dist/tabs.js",
    "./midi": "./dist/midi.js",
    "./table-sort": "./dist/table-sort.js",
    "./timeline": "./dist/timeline.js",
    "./utils": "./dist/utils.js",
    "./i18n": "./dist/i18n.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nandovejer/luz.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/nandovejer/luz#readme",
  "bugs": {
    "url": "https://github.com/nandovejer/luz/issues"
  },
  "keywords": [
    "design-system",
    "css",
    "components",
    "vanilla-js",
    "itcss",
    "accessibility",
    "a11y"
  ],
  "sideEffects": [
    "*.css",
    "./dist/luz.js",
    "./dist/luz.min.js",
    "./dist/timeline.js",
    "./dist/timeline.min.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@luz-ds/tokens": "^0.1.0"
  },
  "devDependencies": {
    "@luz-ds/tokens": "workspace:*"
  }
}
