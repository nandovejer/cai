{
  "name": "@luz-ds/landing",
  "version": "0.0.0",
  "description": "LUZ Design System — patterns for a landing page (feature grid), built on @luz-ds/site",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./css": "./dist/landing.css",
    "./css/min": "./dist/landing.min.css",
    "./components/*": "./dist/components/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nandovejer/luz.git",
    "directory": "packages/landing"
  },
  "homepage": "https://github.com/nandovejer/luz#readme",
  "bugs": {
    "url": "https://github.com/nandovejer/luz/issues"
  },
  "keywords": [
    "design-system",
    "css",
    "landing-page",
    "patterns",
    "vanilla"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@luz-ds/core": "^0.1.0",
    "@luz-ds/site": "^0.1.0",
    "@luz-ds/tokens": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@luz-ds/site": {
      "optional": true
    }
  },
  "devDependencies": {
    "@luz-ds/core": "workspace:*",
    "@luz-ds/site": "workspace:*",
    "@luz-ds/tokens": "workspace:*"
  }
