{
  "name": "@cai-ds/platform",
  "version": "2.0.0",
  "description": "CAI Design System — app-level shell patterns built on @cai-ds/core",
  "license": "MIT",
  "type": "module",
  "main": "dist/platform.js",
  "exports": {
    ".": "./dist/platform.js",
    "./search": "./dist/search.js",
    "./css": "./dist/platform.css",
    "./css/min": "./dist/platform.min.css",
    "./placeholders/*": "./dist/placeholders/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nandovejer/cai.git",
    "directory": "packages/platform"
  },
  "homepage": "https://github.com/nandovejer/cai#readme",
  "bugs": {
    "url": "https://github.com/nandovejer/cai/issues"
  },
  "keywords": [
    "design-system",
    "css",
    "platform",
    "shell",
    "layout",
    "vanilla"
  ],
  "sideEffects": [
    "*.css",
    "./dist/platform.js",
    "./dist/platform.min.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@cai-ds/core": "^2.0.0",
    "@cai-ds/tokens": "^2.0.0"
  },
  "devDependencies": {
    "@cai-ds/core": "workspace:*",
    "@cai-ds/tokens": "workspace:*"
  }
}
