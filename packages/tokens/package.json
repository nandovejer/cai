{
  "name": "@cai-ds/tokens",
  "version": "2.0.0",
  "description": "CAI Design System — design tokens (CSS custom properties) and self-hosted MIT-licensed web fonts",
  "license": "MIT",
  "type": "module",
  "style": "./dist/cai-tokens.css",
  "exports": {
    ".": {
      "style": "./dist/cai-tokens.css",
      "default": "./dist/cai-tokens.css"
    },
    "./css": "./dist/cai-tokens.css",
    "./css/min": "./dist/cai-tokens.min.css",
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./tokens.json": "./dist/tokens.json",
    "./dtcg": "./dist/cai-tokens.dtcg.json",
    "./fonts/*": "./dist/fonts/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nandovejer/cai.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/nandovejer/cai#readme",
  "bugs": {
    "url": "https://github.com/nandovejer/cai/issues"
  },
  "keywords": [
    "design-system",
    "css",
    "design-tokens",
    "web-fonts",
    "vanilla",
    "css-custom-properties"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  }
}
