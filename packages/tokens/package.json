{
  "name": "@luz-ds/tokens",
  "version": "0.0.0",
  "description": "LUZ Design System — design tokens (CSS custom properties) and self-hosted MIT-licensed web fonts",
  "license": "MIT",
  "type": "module",
  "bin": {
    "luz-tokens": "./bin/luz-tokens.js"
  },
  "style": "./dist/luz-tokens.css",
  "exports": {
    ".": {
      "style": "./dist/luz-tokens.css",
      "default": "./dist/luz-tokens.css"
    },
    "./css": "./dist/luz-tokens.css",
    "./css/min": "./dist/luz-tokens.min.css",
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./tokens.json": "./dist/tokens.json",
    "./dtcg": "./dist/luz-tokens.dtcg.json",
    "./dtcg/resolver": "./dist/luz-tokens.resolver.json",
    "./fonts/*": "./dist/fonts/*",
    "./classes.json": "./dist/classes.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "lib",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nandovejer/luz.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/nandovejer/luz#readme",
  "bugs": {
    "url": "https://github.com/nandovejer/luz/issues"
  },
  "keywords": [
    "design-system",
    "css",
    "design-tokens",
    "web-fonts",
    "vanilla",
    "css-custom-properties",
    "wcag",
    "contrast"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  }
}
