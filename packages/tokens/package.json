{
  "name": "@cai-ds/tokens",
  "version": "2.0.0-beta.2",
  "description": "CAI Design System — design tokens (CSS custom properties) and self-hosted IBM Plex web fonts",
  "license": "MIT",
  "type": "module",
  "main": "dist/cai-tokens.css",
  "exports": {
    ".": {
      "style": "./dist/cai-tokens.css",
      "default": "./dist/cai-tokens.css"
    },
    "./css": "./dist/cai-tokens.css"
  },
  "files": ["dist"],
  "repository": {
    "type": "git",
    "url": "https://github.com/nandovejer/cai.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/nandovejer/cai#readme",
  "bugs": {
    "url": "https://github.com/nandovejer/cai/issues"
  },
  "keywords": ["design-system", "css", "design-tokens", "web-fonts", "ibm-plex", "vanilla", "css-custom-properties"],
  "sideEffects": ["dist/cai-tokens.css"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/build-tokens.js"
  }
