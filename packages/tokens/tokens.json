  "spacing": {
    "unit": { "value": "0.25rem", "type": "dimension", "description": "The 4px grid, in rem so spacing follows the reader's font size. Every --luz-space-* step is a multiple of it. Set it on :root; components read the steps, never this." },
    "3xs": { "value": "2px", "type": "dimension", "from": "calc(var(--luz-space-unit) / 2)" },
    "2xs": { "value": "4px", "type": "dimension", "from": "var(--luz-space-unit)" },
    "xs": { "value": "8px", "type": "dimension", "from": "calc(var(--luz-space-unit) * 2)" },
    "sm": { "value": "12px", "type": "dimension", "from": "calc(var(--luz-space-unit) * 3)" },
    "md": { "value": "16px", "type": "dimension", "from": "calc(var(--luz-space-unit) * 4)" },
    "lg": { "value": "24px", "type": "dimension", "from": "calc(var(--luz-space-unit) * 6)" },
    "xl": { "value": "32px", "type": "dimension", "from": "calc(var(--luz-space-unit) * 8)" },
    "2xl": { "value": "48px", "type": "dimension", "from": "calc(var(--luz-space-unit) * 12)" },
    "3xl": { "value": "64px", "type": "dimension", "from": "calc(var(--luz-space-unit) * 16)" },
    "4xl": { "value": "96px", "type": "dimension", "from": "calc(var(--luz-space-unit) * 24)" }
  },
  "control": {
    "sm": { "value": "28px", "type": "dimension" },
    "md": { "value": "36px", "type": "dimension" },
    "lg": { "value": "44px", "type": "dimension" },
    "xl": { "value": "56px", "type": "dimension" }
  },
  "typography": {
    "font-sans":  { "value": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif", "type": "fontFamily" },
    "font-serif": { "value": "\"ET Book\", charter, \"Bitstream Charter\", \"Sitka Text\", cambria, georgia, serif", "type": "fontFamily" },
    "font-mono":  { "value": "ui-monospace, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace", "type": "fontFamily" },
    "type-base":  { "value": "1rem", "type": "fontSize", "description": "The size of --luz-text-base, and the base every step of the type scale is computed from. Write it in rem so the reader's browser setting keeps working. Set it on :root; components read the --luz-text-* steps, never this." },
    "type-ratio": { "value": "1.25", "type": "number", "description": "The multiple between two steps above the base, and the divisor below it. Set it on :root; components read the --luz-text-* steps, never this." },
    "text-xs":   { "value": "0.75rem",   "type": "fontSize", "from": "max(0.75rem, calc(var(--luz-text-sm) / var(--luz-type-ratio)))", "fromRounded": "max(0.75rem, round(calc(var(--luz-text-sm) / var(--luz-type-ratio)), 0.0625rem))", "description": "12px at a 16px root. Absolute floor: micro-copy only (badges, tags, counters), never running text." },
    "text-sm":   { "value": "0.875rem",  "type": "fontSize", "from": "max(0.875rem, calc(var(--luz-text-base) / var(--luz-type-ratio)))", "fromRounded": "max(0.875rem, round(calc(var(--luz-text-base) / var(--luz-type-ratio)), 0.0625rem))", "description": "14px. Floor for secondary and UI text: helper/error text, captions, table headers, breadcrumbs." },
    "text-md":   { "value": "0.9375rem", "type": "fontSize", "from": "calc((var(--luz-text-sm) + var(--luz-text-base)) / 2)", "fromRounded": "round(calc((var(--luz-text-sm) + var(--luz-text-base)) / 2), 0.0625rem)", "description": "15px. Default UI text: buttons, labels, table cells, tabs, navigation." },
    "text-base": { "value": "1rem",      "type": "fontSize", "from": "var(--luz-type-base)", "description": "16px. Body and running text; form fields on touch screens." },
    "text-lg":   { "value": "1.25rem",   "type": "fontSize", "from": "calc(var(--luz-text-base) * var(--luz-type-ratio))", "fromRounded": "round(calc(var(--luz-text-base) * var(--luz-type-ratio)), 0.0625rem)" },
    "text-xl":   { "value": "1.5625rem", "type": "fontSize", "from": "calc(var(--luz-text-lg) * var(--luz-type-ratio))", "fromRounded": "round(calc(var(--luz-text-lg) * var(--luz-type-ratio)), 0.0625rem)" },
    "text-2xl":  { "value": "1.9375rem", "type": "fontSize", "from": "calc(var(--luz-text-xl) * var(--luz-type-ratio))", "fromRounded": "round(calc(var(--luz-text-xl) * var(--luz-type-ratio)), 0.0625rem)" },
    "text-3xl":  { "value": "2.4375rem", "type": "fontSize", "from": "calc(var(--luz-text-2xl) * var(--luz-type-ratio))", "fromRounded": "round(calc(var(--luz-text-2xl) * var(--luz-type-ratio)), 0.0625rem)" },
    "text-4xl":  { "value": "3.0625rem", "type": "fontSize", "from": "calc(var(--luz-text-3xl) * var(--luz-type-ratio))", "fromRounded": "round(calc(var(--luz-text-3xl) * var(--luz-type-ratio)), 0.0625rem)" }
  },
  "radius": {
    "none": { "value": "0px",    "type": "borderRadius", "description": "Square: a box that joins a neighbour, or a field drawn by its bottom edge only." },
    "sm":   { "value": "2px",    "type": "borderRadius", "description": "Small marks: inline code, kbd, mark, a checkbox, a thin bar, a row inside a rounded box." },
    "md":   { "value": "4px",    "type": "borderRadius", "description": "The corner of every box: buttons, cards, alerts, menus, dialogs. The ceiling: no rectangle is rounder." },
    "full": { "value": "9999px", "type": "borderRadius", "description": "A pill or a circle, for shapes that are round by nature: a switch track, a count badge, a dot." }
  },
  "shadow": {
    "sm": { "value": "0 1px 2px rgba(35,28,22,.08), 0 0 1px rgba(35,28,22,.1)", "type": "shadow" },
    "md": { "value": "0 4px 10px rgba(35,28,22,.1), 0 2px 4px rgba(35,28,22,.06)", "type": "shadow" },
    "lg": { "value": "0 14px 28px rgba(35,28,22,.14), 0 6px 12px rgba(35,28,22,.08)", "type": "shadow" },
    "icon": { "value": "0 2px 8px rgba(0,0,0,.5)", "type": "shadow" }
  }
}
